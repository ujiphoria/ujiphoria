<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 4" width="1000" height="4" preserveAspectRatio="none" role="img" aria-label="divider" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="g" x1="0" y1="0" x2="1" y2="0" gradientUnits="objectBoundingBox">
      <stop offset="0%" stop-color="#4f46e5"/>
      <stop offset="50%" stop-color="#db2777"/>
      <stop offset="100%" stop-color="#4f46e5"/>
      <animateTransform attributeName="gradientTransform" type="translate" from="-1 0" to="1 0" dur="4s" repeatCount="indefinite"/>
    </linearGradient>
  </defs>
  <rect width="1000" height="4" rx="2" fill="url(#g)"/>
</svg>

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 120" width="1000" height="120" role="img" aria-label="Footer" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#4f46e5"/>
      <stop offset="100%" stop-color="#db2777"/>
    </linearGradient>
  </defs>
  <rect width="1000" height="120" fill="url(#bg)"/>
  <g fill="#ffffff">
    <circle cx="150" cy="70" r="2.5"><animate attributeName="opacity" values="0.1;1;0.1" dur="2s" repeatCount="indefinite"/></circle>
    <circle cx="380" cy="90" r="2" ><animate attributeName="opacity" values="1;0.1;1" dur="3s" repeatCount="indefinite"/></circle>
    <circle cx="620" cy="60" r="3"><animate attributeName="opacity" values="0.1;1;0.1" dur="2.5s" repeatCount="indefinite"/></circle>
    <circle cx="850" cy="85" r="2"><animate attributeName="opacity" values="1;0.1;1" dur="1.8s" repeatCount="indefinite"/></circle>
  </g>
  <path fill="#0d1117" d="M0,20 Q125,0 250,20 T500,20 T750,20 T1000,20 T1250,20 T1500,20 T1750,20 T2000,20 V0 H0 Z">
    <animateTransform attributeName="transform" type="translate" from="0 0" to="-500 0" dur="6s" repeatCount="indefinite"/>
  </path>
  <path fill="#ffffff" fill-opacity="0.2" d="M0,40 Q125,20 250,40 T500,40 T750,40 T1000,40 T1250,40 T1500,40 T1750,40 T2000,40 V0 H0 Z">
    <animateTransform attributeName="transform" type="translate" from="0 0" to="-500 0" dur="10s" repeatCount="indefinite"/>
  </path>
</svg>

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 240" width="1000" height="240" role="img" aria-label="Header" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#4f46e5">
        <animate attributeName="stop-color" values="#4f46e5;#7c3aed;#db2777;#7c3aed;#4f46e5" dur="12s" repeatCount="indefinite"/>
      </stop>
      <stop offset="100%" stop-color="#db2777">
        <animate attributeName="stop-color" values="#db2777;#4f46e5;#7c3aed;#4f46e5;#db2777" dur="12s" repeatCount="indefinite"/>
      </stop>
    </linearGradient>
  </defs>

  <rect width="1000" height="240" fill="url(#bg)"/>

  <!-- partikel melayang -->
  <g fill="#ffffff">
    <circle cx="120" cy="150" r="4" opacity="0.5"><animate attributeName="cy" values="150;60;150" dur="6s" repeatCount="indefinite"/></circle>
    <circle cx="300" cy="190" r="3" opacity="0.4"><animate attributeName="cy" values="190;90;190" dur="8s" repeatCount="indefinite"/></circle>
    <circle cx="520" cy="170" r="5" opacity="0.35"><animate attributeName="cy" values="170;40;170" dur="7s" repeatCount="indefinite"/></circle>
    <circle cx="760" cy="180" r="3" opacity="0.45"><animate attributeName="cy" values="180;70;180" dur="9s" repeatCount="indefinite"/></circle>
    <circle cx="900" cy="140" r="4" opacity="0.4"><animate attributeName="cy" values="140;50;140" dur="5s" repeatCount="indefinite"/></circle>
  </g>

  <!-- teks -->
  <g text-anchor="middle" font-family="'Segoe UI', Helvetica, Arial, sans-serif" fill="#ffffff">
    <text x="500" y="105" font-size="58" font-weight="700" opacity="0">
      Nama Kamu
      <animate attributeName="opacity" from="0" to="1" dur="1.2s" fill="freeze"/>
    </text>
    <text x="500" y="150" font-size="22" opacity="0" letter-spacing="2">
      Front-End Developer &amp; Graphic Designer
      <animate attributeName="opacity" from="0" to="0.95" begin="0.8s" dur="1.2s" fill="freeze"/>
    </text>
  </g>

  <!-- gelombang -->
  <path fill="#ffffff" fill-opacity="0.18" d="M0,185 Q125,155 250,185 T500,185 T750,185 T1000,185 T1250,185 T1500,185 T1750,185 T2000,185 V240 H0 Z">
    <animateTransform attributeName="transform" type="translate" from="0 0" to="-500 0" dur="9s" repeatCount="indefinite"/>
  </path>
  <path fill="#ffffff" fill-opacity="0.28" d="M-500,200 Q-375,170 -250,200 T0,200 T250,200 T500,200 T750,200 T1000,200 T1250,200 T1500,200 V240 H-500 Z">
    <animateTransform attributeName="transform" type="translate" from="0 0" to="500 0" dur="7s" repeatCount="indefinite"/>
  </path>
  <path fill="#0d1117" d="M0,220 Q125,200 250,220 T500,220 T750,220 T1000,220 T1250,220 T1500,220 T1750,220 T2000,220 V240 H0 Z">
    <animateTransform attributeName="transform" type="translate" from="0 0" to="-500 0" dur="5s" repeatCount="indefinite"/>
  </path>
</svg>
